# ── Supabase ──────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Square Web Payments SDK (PUBLIC client values) ────────────────────────
# 'sandbox' for testing, 'production' for live charges
VITE_SQUARE_ENVIRONMENT=sandbox
VITE_SQUARE_APP_ID=
VITE_SQUARE_LOCATION_ID=

# ──────────────────────────────────────────────────────────────────────────
# Server-side Square secrets are stored in Supabase (NOT in this file):
#
#   supabase secrets set SQUARE_ACCESS_TOKEN=...
#   supabase secrets set SQUARE_ENVIRONMENT=sandbox
#   supabase secrets set SQUARE_LOCATION_ID=...
#
# The access token must NEVER be exposed to the client.
# ──────────────────────────────────────────────────────────────────────────
